{
  "name": "wassa-east-projects",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "deploy:check": "tsx scripts/check-deployment.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests docs *.json *.ts *.mjs *.yaml README.md",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:acceptance": "playwright test --config=playwright.acceptance.config.ts",
    "test:migrations": "tsx scripts/rehearse-migrations.ts",
    "test:notifications": "node --conditions=react-server --import tsx --test tests/integration/notifications.test.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "staff:bootstrap": "tsx scripts/bootstrap.ts",
    "staff:accounts": "tsx scripts/staff-account.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.20",
    "better-auth": "1.7.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.4",
    "ipaddr.js": "2.2.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.6",
    "pg": "^8.16.3",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.0",
    "web-push": "3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
