{
  "name": "wassa-east-projects",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node scripts/build-sw.mjs",
    "prebuild": "node scripts/build-sw.mjs",
    "push:keys": "node scripts/push-keys.mjs",
    "deploy:check": "tsx scripts/check-deployment.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests docs *.json *.ts *.mjs *.yaml README.md",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:acceptance": "playwright test --config=playwright.acceptance.config.ts",
    "test:load": "playwright test --config=playwright.load.config.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "staff:bootstrap": "tsx scripts/bootstrap.ts",
    "worker": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@fontsource-variable/dm-sans": "latest",
    "@fontsource-variable/newsreader": "latest",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "drizzle-orm": "latest",
    "exceljs": "^4.4.0",
    "lucide-react": "latest",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "otpauth": "^9.4.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "pg-boss": "12.38.0",
    "qrcode": "^1.5.4",
    "radix-ui": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "esbuild": "$esbuild"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "latest",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
