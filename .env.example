# Copy to .env.local for local development. Never commit populated secrets.
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Generate a different 64-character hexadecimal encryption key for each environment.
MFA_ENCRYPTION_KEY=
DATABASE_URL=postgresql://wassa:CHANGE_ME@localhost:55432/wassa
MEDIA_ROOT=./.local/media
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser map key: restrict allowed domains in Geoapify. Never use a privileged server credential.
GEOAPIFY_API_KEY=
# Must be false in production; sample data/design routes never access live records.
ENABLE_DESIGN_PREVIEW=true
# Optional escape hatch for the bounded, publication-versioned public HTML cache.
ENABLE_PUBLIC_RENDER_CACHE=true
# Keep false until an approved HTTPS URL or mailto sender identity is configured.
ENABLE_BROWSER_PUSH=false
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Only enable behind a proxy that overwrites incoming forwarded IP headers.
TRUST_PROXY_HEADERS=false
