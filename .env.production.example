# Enter real values in Coolify, never this file.
APP_URL=
# Pin release-specific image tags or digests.
WEB_IMAGE=
TOOLS_IMAGE=
# Independently generated production secrets, at least 32 characters each.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Only for controlled local production builds (compose.yaml). GH images embed this.
# Format: sha-<40 lowercase hex commit>-<numeric run>-<numeric attempt>
RELEASE_ID=
# Optional public integrations. Set email values together after verifying the sender and office mailbox.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
GOOGLE_PLAY_URL=
APP_STORE_URL=

# Notifications: the dispatcher builds inboxes even while phone delivery is off.
ENABLE_BROWSER_PUSH=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://wassaeastprojecttracker.com
# Independent 32 random bytes encoded as unpadded base64url. Keep stable.
NOTIFICATION_ENCRYPTION_KEY=
