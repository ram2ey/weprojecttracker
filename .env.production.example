# Configuration template only. Enter real values in Coolify, never this file.
# For a local configuration check, copy to ignored .env.production.local and run:
# npm run deploy:check -- --env-file .env.production.local
APP_URL=
# Use release-specific registry tags or, preferably, sha256 image digests.
# Prepared workflow image names: ghcr.io/ram2ey/weprojecttracker-web and
# ghcr.io/ram2ey/weprojecttracker-tools. Fill in the successful release digests.
WEB_IMAGE=
TOOLS_IMAGE=
# Generate independent production secrets; never copy development credentials.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
MFA_ENCRYPTION_KEY=
# Both Google fields may remain empty during preparation; Google acceptance is pending.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; the map has a fallback without this browser key.
GEOAPIFY_API_KEY=
ENABLE_PUBLIC_RENDER_CACHE=true
# Enable only after confirming the proxy overwrites incoming forwarded headers.
TRUST_PROXY_HEADERS=false
# Production environment, disabled design preview and disabled live push are fixed
# in compose.coolify.yaml. Do not import .env.local into Coolify.
